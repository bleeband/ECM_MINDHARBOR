// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id String @id @default(cuid())
    username String @unique
    email String @unique
    motdepasse String
    role Role @default(VISITEUR)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    journalEntries JournalEntry[]
    favorite Favorite[]
    reports Report[]
    refreshTokens RefreshToken[]
}

model JournalEntry {
    id String @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    date DateTime @db.Date
    humeur Int 
    energie Int
    qualite_sommeil Int
    anxiete_stress Int
    evenements String
    gratitude String?

    userId String
    user User @relation(fields: [userId], references: [id], onDelete:Cascade)
    activities JournalActivity[]

    @@unique([userId, date])
}

model Activity {
    id String @id @default(cuid())
    nom String @unique
    createdAt DateTime @default(now())

    journalActivities JournalActivity[]

}

model JournalActivity {
    journalEntryId String
    journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
    activityId String
    activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([journalEntryId, activityId])
    

}

model Resource {
    id String @id @default(cuid())
    type TypeResource

    favorites Favorite[]
}

model Favorite { // relation N-N entre utilisateur et ressource
    userId String
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    resourceId String
    resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([userId, resourceId])

}

model Group {
    id String @id @default(cuid())

}

model GroupMember {
    id String @id @default(cuid())

}

model Post {
    id String @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    titre String
    contenu String
    visibilite Visibilite @default(PRIVE)

}

model Comment {
    id String @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    body String
}

model Message {
    id String @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    titre String
    contenu String
}

model Report {
    id String @id @default(cuid())
    emetteurId String
    emetteur User @relation(fields: [emetteurId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    contenu String


}

model RefreshToken {
    id String @id @default(cuid())
    token String @unique
    userId String
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    // recherche plus rapide pour trouver les sessions de lutilisateur
    @@index([userId])

}

// -----ENUMS-----

enum TypeResource {
    ARTICLE
    EXERCICE
    FICHE_PRATIQUE
}

enum Role {
    VISITEUR
    UTILISATEUR
    MODERATEUR
    ADMINISTRATEUR
}

enum Visibilite {
    PUBLIQUE
    PRIVE
}