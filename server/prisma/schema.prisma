// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
    id String @id @default(cuid())
    username String @unique
    email String @unique
    motdepasse String
    role Role @default(VISITEUR)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    journalEntries JournalEntry[]
    favorite Favorite[]
    refreshTokens RefreshToken[]
    groupMembers GroupMember[]
    comments Comment[]
    posts Post[]
    messagesEnvoyes Message[] @relation("MessagesEnvoyes")
    messagesRecus Message[] @relation("MessagesRecus")
    signalementsEmis Report[] @relation("SignalementsEmis")
    signalementsRecus Report[] @relation("SignalementsRecus")

}

model JournalEntry {
    id String @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    date DateTime @db.Date
    humeur Int 
    energie Int
    qualite_sommeil Int
    anxiete_stress Int
    evenements String
    gratitude String?

    userId String
    user User @relation(fields: [userId], references: [id], onDelete:Cascade)
    activities JournalActivity[]

    @@unique([userId, date])
}

model Activity {
    id String @id @default(cuid())
    nom String @unique
    createdAt DateTime @default(now())

    journalActivities JournalActivity[]

}

model JournalActivity { // relation N-N entre JournalEntry et Activity
    journalEntryId String
    journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
    activityId String
    activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([journalEntryId, activityId])
    

}

model Resource {
    id String @id @default(cuid())
    type TypeResource
    titre String
    url String?
    contenu String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    favorites Favorite[]
}

model Favorite { // relation N-N entre utilisateur et ressource
    userId String
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    resourceId String
    resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@id([userId, resourceId])

}

model Group {
    id String @id @default(cuid())
    nom String
    description String

    posts Post[]
    groupMembers GroupMember[]


}

model GroupMember {
    userId String
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    groupId String
    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    statutDemande StatutDemande?

    @@id([userId, groupId])

}

model Post {
    id String @id @default(cuid())
    authorId String
    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
    groupeId String
    group Group @relation(fields: [groupeId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    titre String
    contenu String
    visibilite Visibilite @default(PRIVE)

    comments Comment[]
    signalements Report[]

}

model Comment {
    id String @id @default(cuid())
    authorId String
    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
    postId String
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    contenu String

    signalements Report[]
}

model Message {
    id String @id @default(cuid())
    senderId String
    sender User @relation("MessagesEnvoyes", fields: [senderId], references: [id], onDelete: Cascade)
    recipientId String
    recipient User @relation("MessagesRecus", fields: [recipientId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    titre String
    contenu String
}

model Report {
    id String @id @default(cuid())
    emetteurId String
    emetteur User @relation("SignalementsEmis", fields: [emetteurId], references: [id], onDelete: Cascade)
    reportedUserId String?
    reported User? @relation("SignalementsRecus", fields: [reportedUserId], references: [id], onDelete: Cascade)
    postId String?
    post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
    commentId String?
    comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    contenu String


}

model RefreshToken {
    id String @id @default(cuid())
    token String @unique
    userId String
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    // recherche plus rapide pour trouver les sessions de lutilisateur
    @@index([userId])

}

// -----ENUMS-----

enum TypeResource {
    ARTICLE
    EXERCICE
    FICHE_PRATIQUE
}

enum Role {
    VISITEUR
    UTILISATEUR
    MODERATEUR
    ADMINISTRATEUR
}

enum Visibilite {
    PUBLIQUE
    PRIVE
}

enum StatutDemande {
    EN_ATTENTE
    ACCEPTEE
    REJETEE
}